  "version": "1.0.0",
  "type": "module",
  "description": "Just For You — a private cinematic journal",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/verify-data.mjs && vite build && node scripts/check-dist.mjs",
